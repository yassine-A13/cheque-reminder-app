
{
  "expo": {
    "name": "Cheque Reminder",
    "slug": "cheque-reminder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "chequereminder",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.local.chequereminder",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4EFE5"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4EFE5"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#0F766E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser l'accès aux images pour associer une photo au chèque.",
          "cameraPermission": "Autoriser l'accès à la caméra pour photographier un chèque."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "f76baf3f-67aa-41a3-b0b9-b86a7d1556c6"
      }
    },

    "runtimeVersion": {
      "policy": "sdkVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/f76baf3f-67aa-41a3-b0b9-b86a7d1556c6"
    }
  }
}
